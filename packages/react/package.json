    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@squiggle/eslint-config": "workspace:*",
    "@squiggle/typescript-config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "dependencies": {
    "@squiggle/core": "workspace:*"
  }
