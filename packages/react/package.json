{
  "name": "@squiggle/react",
  "version": "0.1.0",
  "description": "React bindings for @squiggle/core — WobblyBox, WobblyShape components and hooks",
  "keywords": ["react", "svg", "doodle", "hand-drawn", "squiggle", "wiggle"],
  "license": "MIT",
  "type": "module",
